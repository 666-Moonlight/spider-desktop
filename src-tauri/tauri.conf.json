{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spider",
  "version": "0.1.0",
  "identifier": "com.spider.standalone",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist",
      "../packaging/seed-settings.json": "seed/settings.json"
    },
    "externalBin": ["binaries/spider-server"]
  }
}
